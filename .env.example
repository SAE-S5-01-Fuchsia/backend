# Copiez ce fichier en `.env` et adaptez les valeurs.
# Ne commitez JAMAIS le fichier `.env` : il contient les secrets.

APP_NAME=Backend
# development | test | production (la doc /docs est désactivée en production)
ENVIRONMENT=development
# Liste JSON des origines web autorisées (inutile pour l'app mobile native)
CORS_ORIGINS=["http://localhost:8081"]
# Délai maximal des appels aux API externes, en secondes
HTTP_TIMEOUT=10

# Ajoutez ici les clés de vos API externes, puis déclarez-les dans
# app/core/config.py. Exemple :
# MON_API_KEY=
